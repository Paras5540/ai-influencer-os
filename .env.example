# Copy to .env and fill. Nothing here is required for --dry-run.

# ---------- AI (free tiers work) ----------
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# ---------- Optional: any OpenAI-compatible LLM (Groq / OpenRouter / your 100M-token provider) ----------
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- Publishing: Instagram (Graph API) ----------
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------- Publishing: YouTube Shorts ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ---------- PREMIUM TIER: Fanvue (api.fanvue.com) ----------
# Register a creator app (needs KYC-complete creator account), then OAuth with PKCE.
# Paste the access token here, or the refresh token + client credentials.
FANVUE_ACCESS_TOKEN=
FANVUE_REFRESH_TOKEN=
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
FANVUE_PRICE_CENTS=699

# ---------- Character ----------
# Kaunsa character use karna hai (config/ folder ka filename + assets/ folder)
CHARACTER_CONFIG=character_v5_locked.json
CHARACTER_DIR=character_v6

# ---------- Behaviour ----------
MUSIC_DIR=assets/music
DRY_RUN=0
MAX_POSTS_PER_DAY=2
